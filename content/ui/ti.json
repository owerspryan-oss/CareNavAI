    "prepare": {
      "draftNotice": "እዚ ንክትዳለዉ ዝሕግዝ ረቂቕ እዩ። ሕክምናዊ ምኽሪ ኣይኮነን።",
      "stepLabel": "ስጉምቲ {n} ካብ {total}",
      "steps": {
        "who": {
          "title": "እዚ ቆጸራ ንመን እዩ?",
          "lead": "ጽማቕኹም ካብቲ ቅኑዕ ርእይቶ ክንጽሕፎ ኢና።"
        },
        "concern": {
          "title": "ምስ ሓኪምኩም ብዛዕባ እንታይ ክትዛረቡ ትደልዩ?",
          "lead": "ብናይ ገዛእ ርእስኹም ቃላት፣ ብዝኾነ ቋንቋ ጽሓፍዎ። ንምዝራቡ ጌጋ መንገዲ የለን።"
        },
        "timing": {
          "title": "ክንደይ ግዜ ጸኒሑን ክንደይ ግዜ ይመጽእን?",
          "lead": "እቶም ዝበለጸ ዝሰማምዑ መልስታት ምረጹ። «ርግጸኛ ኣይኮንኩን» ምባል እውን ጸገም የብሉን።"
        },
        "changes": {
          "title": "ዝኾነ ለውጢ ወይ ዝደጋገም ኩነታት ኣስተብሂልኩም ዶ?",
          "lead": "ንኣብነት፣ ብለይቲ፣ ድሕሪ መግቢ ወይ ኣብ ፍሉያት ሰዓታት ዝገድድ እንተኾይኑ።"
