      "stepLabel": "Etap {n} sou {total}",
      "steps": {
        "who": {
          "title": "Pou ki moun randevou sa a ye?",
          "lead": "N ap ekri rezime ou a selon bon pwen de vi a."
        },
        "concern": {
          "title": "Kisa ou ta renmen pale ak doktè ou sou li?",
          "lead": "Ekri l ak pwòp mo pa ou, nan nenpòt lang. Pa gen move fason pou di l."
        },
        "timing": {
          "title": "Depi konbyen tan, e konbyen fwa?",
          "lead": "Chwazi repons ki pi byen koresponn. “Mwen pa sèten” bon tou."
        },
        "changes": {
          "title": "Èske ou remake nenpòt chanjman oswa bagay ki konn repete?",
          "lead": "Pa egzanp, si li pi mal lannwit, apre ou manje, oswa a sèten lè."
        },
        "medicines": {
          "title": "Medikaman ak èd ou resevwa deja",
          "lead": "Etap sa a pa obligatwa. Ou ka sote l."
        },
        "worries": {
          "title": "Èske gen yon bagay k ap enkyete ou, oswa ki fè li difisil pou pale sou sa?",
          "lead": "Etap sa a pa obligatwa. Ou ka sote l."
        },
        "review": {
          "title": "Tcheke repons ou yo",
          "lead": "Ou ka chanje nenpòt bagay anvan nou fè rezime ou a."
