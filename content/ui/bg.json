      }
    },
    "prepare": {
      "draftNotice": "Това е чернова, която да ви помогне да се подготвите. Това не е медицински съвет.",
      "stepLabel": "Стъпка {n} от {total}",
      "steps": {
        "who": {
          "title": "За кого е този преглед?",
          "lead": "Ще напишем обобщението ви от правилната гледна точка."
        },
        "concern": {
          "title": "За какво искате да говорите с лекаря си?",
          "lead": "Напишете го със свои думи, на какъвто и да е език. Няма грешен начин да го кажете."
        },
        "timing": {
          "title": "Откога и колко често?",
          "lead": "Изберете отговорите, които пасват най-добре. „Не съм сигурен/сигурна“ също е наред."
        },
        "changes": {
          "title": "Забелязали ли сте промени или закономерности?",
          "lead": "Например дали е по-зле през нощта, след хранене или в определени часове."
        },
        "medicines": {
          "title": "Лекарства и помощ досега",
          "lead": "Тази стъпка не е задължителна. Можете да я пропуснете."
        },
