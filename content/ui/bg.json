    "common": {
      "landing": {
        "headline": "Нека се подготвим за вашия преглед.",
        "lead": "Ясна информация. По-добър разговор с лекаря. Ще се справите.",
        "navLabel": "Изберете от какво имате нужда",
        "prepare": "Подготовка за моя преглед",
        "understand": "Да разбера какво ми казаха",
        "guest": "Режим за гости — нищо не се запазва.",
