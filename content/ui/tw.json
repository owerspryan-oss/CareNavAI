  "messages": {
    "common": {
      "landing": {
        "headline": "Ma yɛnsiesie yɛn ho mma wo nhyiam no.",
        "lead": "Nsɛm a emu da hɔ. Nkɔmmɔbɔ a eye. Wobɛtumi ayɛ.",
        "navLabel": "Paw nea wohia",
        "prepare": "Siesie me ho ma me nhyiam no",
        "understand": "Te nea wɔka kyerɛɛ me no ase",
        "guest": "Ɔhɔho kwan — yɛnkora hwee so.",
        "signIn": "Kɔ mu",
        "signedIn": "Woakɔ mu. Yɛakora wo nsɛm tiawa no so.",
        "account": "Wo akawnt"
      },
      "language": {
        "label": "Kasa",
        "unreviewedNotice": "Mfiri na ɛkyerɛɛ kratafa yi ase, na obi a ɔka kasa yi sɛ ne kurom kasa nnya nhwɛɛ mu."
      },
      "meta": {
        "description": "Siesie wo ho ma wo NHS nhyiam no, na te nea wɔka kyerɛɛ wo no ase.",
        "prepareTitle": "Siesie me ho ma me nhyiam no",
        "understandTitle": "Te nea wɔka kyerɛɛ me no ase",
        "accountTitle": "Wo akawnt"
      }
    },
    "prepare": {
      "draftNotice": "Eyi yɛ nhyehyɛe a ɛnwiee (draft) a ɛbɛboa wo ma woasiesie wo ho. Ɛnyɛ ayaresa ho afotu.",
      "stepLabel": "Anammɔn {n} wɔ {total} mu",
      "steps": {
        "who": {
          "title": "Hwan na saa nhyiam yi wɔ ma no?",
          "lead": "Yɛbɛkyerɛw wo nsɛm tiawa no afi ɔkwan pa so."
        },
        "concern": {
          "title": "Dɛn na wopɛ sɛ wo ne wo dɔkota kasa fa ho?",
          "lead": "Kyerɛw no wɔ wo ankasa wo nsɛm mu, kasa biara mu. Ɔkwan bɔne biara nni hɔ a wobɛfa so aka."
        },
        "timing": {
          "title": "Ɛyɛ bere tenten sɛn, na ɛba mpɛn ahe?",
          "lead": "Paw mmuae a ɛfata paa. “Minnim pɔtee” nso yɛ."
        },
        "changes": {
          "title": "Woahu nsakrae bi anaa sɛnea ɛtaa ba?",
          "lead": "Sɛ nhwɛso no, sɛ ɛyɛ den anadwo, wodidi wie a, anaa bere pɔtee bi mu."
        },
        "medicines": {
          "title": "Nnuru ne mmoa a woanya kosi nnɛ",
          "lead": "Anammɔn yi nyɛ dɛ ɛsɛ sɛ woyɛ. Wobɛtumi atwa mu."
