  "messages": {
    "common": {
      "landing": {
        "headline": "让我们一起为您的就诊做好准备。",
        "lead": "信息清楚，沟通更顺畅。您一定可以的。",
        "navLabel": "选择您需要的帮助",
        "prepare": "为我的就诊做准备",
        "understand": "弄明白医生跟我说了什么",
        "guest": "访客模式 — 不会保存任何内容。",
        "signIn": "登录",
        "signedIn": "已登录。您的摘要会被保存。",
        "account": "您的账户"
      },
      "language": {
        "label": "语言",
        "unreviewedNotice": "本页面是自动翻译的，还没有经过母语人士检查。"
      },
      "meta": {
        "description": "为您的 NHS 就诊做好准备，并弄明白医生跟您说了什么。",
        "prepareTitle": "为我的就诊做准备",
        "understandTitle": "弄明白医生跟我说了什么",
        "accountTitle": "您的账户"
      }
    },
    "prepare": {
      "draftNotice": "这是一份帮助您做准备的草稿，不是医疗建议。",
      "stepLabel": "第 {n} 步，共 {total} 步",
      "steps": {
        "who": {
          "title": "这次就诊是为谁预约的？",
          "lead": "我们会从正确的角度为您写摘要。"
        },
        "concern": {
          "title": "您想和医生谈些什么？",
          "lead": "用您自己的话写，任何语言都可以。怎么说都没有错。"
        },
        "timing": {
          "title": "持续多久了？多久出现一次？",
          "lead": "选择最符合的答案。选“我不确定”也可以。"
        },
        "changes": {
          "title": "您有没有注意到什么变化或规律？",
          "lead": "例如，晚上、饭后或某些时候是否更严重。"
        },
        "medicines": {
          "title": "药物和目前得到的帮助",
          "lead": "这一步可以不填，您可以跳过。"
        },
        "worries": {
          "title": "有没有什么让您担心，或让您难以开口的事？",
          "lead": "这一步可以不填，您可以跳过。"
        },
