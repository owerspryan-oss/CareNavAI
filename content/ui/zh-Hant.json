  "messages": {
    "common": {
      "landing": {
        "headline": "讓我們一起為你的應診做好準備。",
        "lead": "資料清楚，溝通更好。你一定做得到。",
        "navLabel": "選擇你需要的幫助",
        "prepare": "為我的應診做準備",
        "understand": "明白醫生跟我說了甚麼",
        "guest": "訪客模式 — 不會儲存任何內容。",
        "signIn": "登入",
        "signedIn": "已登入。你的摘要會被儲存。",
        "account": "你的帳戶"
      },
      "language": {
        "label": "語言",
        "unreviewedNotice": "本頁是自動翻譯的，尚未經母語人士檢查。"
      },
      "meta": {
        "description": "為你的 NHS 應診做好準備，並明白醫生跟你說了甚麼。",
        "prepareTitle": "為我的應診做準備",
        "understandTitle": "明白醫生跟我說了甚麼",
        "accountTitle": "你的帳戶"
      }
    },
    "prepare": {
      "draftNotice": "這是一份幫助你準備的草稿，並不是醫療建議。",
      "stepLabel": "第 {n} 步，共 {total} 步",
      "steps": {
        "who": {
          "title": "這次應診是為誰預約的？",
          "lead": "我們會從正確的角度為你撰寫摘要。"
        },
        "concern": {
          "title": "你想和醫生談些甚麼？",
          "lead": "用你自己的話寫，任何語言都可以。怎樣說都沒有錯。"
        },
        "timing": {
          "title": "持續了多久？多久出現一次？",
          "lead": "選擇最合適的答案。選「我不確定」也可以。"
        },
        "changes": {
          "title": "你有沒有留意到任何變化或規律？",
          "lead": "例如，晚上、飯後或某些時間是否更嚴重。"
        },
        "medicines": {
          "title": "藥物和至今得到的幫助",
          "lead": "這一步可以不填，你可以跳過。"
        },
