  "messages": {
    "common": {
      "landing": {
        "headline": "നിങ്ങളുടെ അപ്പോയിന്റ്മെന്റിനായി നമുക്ക് തയ്യാറെടുക്കാം.",
        "lead": "വ്യക്തമായ വിവരങ്ങൾ. മെച്ചപ്പെട്ട സംഭാഷണങ്ങൾ. നിങ്ങൾക്ക് ഇത് കഴിയും.",
        "navLabel": "നിങ്ങൾക്ക് വേണ്ടത് തിരഞ്ഞെടുക്കുക",
        "prepare": "എന്റെ അപ്പോയിന്റ്മെന്റിനായി തയ്യാറെടുക്കുക",
        "understand": "എന്നോട് പറഞ്ഞത് മനസ്സിലാക്കുക",
        "guest": "അതിഥി മോഡ് — ഒന്നും സേവ് ചെയ്യില്ല."
      },
      "language": {
        "label": "ഭാഷ",
        "unreviewedNotice": "ഈ പേജ് സ്വയമേവ വിവർത്തനം ചെയ്തതാണ്. മാതൃഭാഷയായി സംസാരിക്കുന്ന ഒരാൾ ഇത് ഇതുവരെ പരിശോധിച്ചിട്ടില്ല."
      },
      "meta": {
        "description": "നിങ്ങളുടെ NHS അപ്പോയിന്റ്മെന്റിനായി തയ്യാറെടുക്കുക, നിങ്ങളോട് പറഞ്ഞത് മനസ്സിലാക്കുക.",
        "prepareTitle": "എന്റെ അപ്പോയിന്റ്മെന്റിനായി തയ്യാറെടുക്കുക",
        "understandTitle": "എന്നോട് പറഞ്ഞത് മനസ്സിലാക്കുക"
      }
    },
    "prepare": {
      "draftNotice": "നിങ്ങൾക്ക് തയ്യാറെടുക്കാൻ സഹായിക്കുന്ന ഒരു ഡ്രാഫ്റ്റ് ആണിത്. ഇത് വൈദ്യോപദേശമല്ല.",
      "stepLabel": "{total}-ൽ ഘട്ടം {n}",
      "steps": {
        "who": {
          "title": "ഈ അപ്പോയിന്റ്മെന്റ് ആർക്കുവേണ്ടിയാണ്?",
          "lead": "നിങ്ങളുടെ സംഗ്രഹം ശരിയായ കാഴ്ചപ്പാടിൽ ഞങ്ങൾ എഴുതും."
        },
        "concern": {
          "title": "നിങ്ങളുടെ ഡോക്ടറോട് എന്തിനെക്കുറിച്ച് സംസാരിക്കാനാണ് നിങ്ങൾ ആഗ്രഹിക്കുന്നത്?",
          "lead": "നിങ്ങളുടെ സ്വന്തം വാക്കുകളിൽ, ഏത് ഭാഷയിലും എഴുതുക. പറയാൻ തെറ്റായ ഒരു രീതിയുമില്ല."
        },
        "timing": {
          "title": "എത്ര കാലമായി, എത്ര തവണ?",
          "lead": "ഏറ്റവും യോജിക്കുന്ന ഉത്തരങ്ങൾ തിരഞ്ഞെടുക്കുക. “എനിക്ക് ഉറപ്പില്ല” എന്നതും കുഴപ്പമില്ല."
        },
        "changes": {
          "title": "എന്തെങ്കിലും മാറ്റങ്ങളോ ഒരു രീതിയോ നിങ്ങൾ ശ്രദ്ധിച്ചോ?",
          "lead": "ഉദാഹരണത്തിന്, രാത്രിയിലോ, ഭക്ഷണത്തിന് ശേഷമോ, ചില സമയങ്ങളിലോ ഇത് കൂടുതലാകുന്നുണ്ടെങ്കിൽ."
        },
        "medicines": {
          "title": "മരുന്നുകളും ഇതുവരെ ലഭിച്ച സഹായവും",
          "lead": "ഈ ഘട്ടം നിർബന്ധമല്ല. നിങ്ങൾക്ക് ഇത് ഒഴിവാക്കാം."
        },
