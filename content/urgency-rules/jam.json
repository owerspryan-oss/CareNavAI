        "(him|her|im|she|di baby|di pickney) (nah|nuh|nuh a) (breathe|breathing|breed)"
      ]
    },
    {
      "id": "jam.breathing.difficult",
      "level": "urgent",
      "category": "breathing",
      "patterns": [
        "(hard|haad) fi (breathe|breed|ketch (mi|me|him|her|im) breath)",
        "(mi|me|him|her|im|she) breath (a |did |deh )?(short|tight)"
      ]
    },
    {
      "id": "jam.chest.pain",
      "level": "urgent",
      "category": "chest_pain",
      "patterns": [
        "chest .{0,15}(a hat|hat|a bun|bun|a buss|a pain|a hurt|tight up)",
        "(mi|me) chest (a )?(hurt|hat|pain|tight)"
      ]
    },
    {
      "id": "jam.bleeding.severe",
      "level": "emergency",
      "category": "severe_bleeding",
      "patterns": [
        "(blood|bleeding|bleed) .{0,15}(nah|nuh|wah nuh|cyaan|caan|kyaan) stop",
        "blood (a |deh )?(pour|gush|run) (out )?(bad|whole heap|nuff)"
      ]
    },
    {
      "id": "jam.consciousness.unresponsive",
      "level": "emergency",
