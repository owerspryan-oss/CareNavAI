      "id": "jam.crisis.suicide_self_harm",
      "level": "crisis",
      "category": "self_harm_or_suicide",
      "patterns": [
        "(nuh|nah|dont|doh) (waan|want|wah|wan) (live|liv|bi yah|be here|deh yah|deh ya|bodda live)",
        "(?<!(nuh|nah|dont|doh) )(waan|wah|wan) (dead|ded|dead off|fi dead|dead now)",
        "kill (miself|meself|mi self|myself)",
        "(mi|me) (tired|tyad|tiad) a (life|live|living)",
        "(mi|me) (a go|gwine|ago|goin) (end it|tek mi life|kill miself)"
      ]
    }
