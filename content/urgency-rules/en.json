{
  "$comment": "DRAFT English red-flag rules (FR-05, PRD 9.1 layer 1). NOT CLINICALLY APPROVED: seed list for the local demo only; the clinical adviser owns the real list. Patterns are regular expressions matched against NORMALISED text: lower case, apostrophes removed (can't -> cant, I'm -> im), '&' -> ' and ' (A&E -> a and e), all other punctuation -> space, whitespace collapsed. Each pattern is matched as whole words. A rule fires when ANY of 'patterns' matches and, if 'requiresAlso' is present, at least one pattern from EVERY group in it also matches.",
  "language": "en",
  "kind": "language",
  "status": "DRAFT_NOT_CLINICALLY_APPROVED",
  "reviewed": false,
  "rules": [
    {
      "id": "en.breathing.cannot_breathe",
      "level": "emergency",
      "category": "breathing",
      "patterns": [
        "(cant|can not|cannot|couldnt|could not|unable to|struggling to|struggles to|fighting to) (breathe|breath|get (my |a |his |her |their )?breath|catch (my |his |her |their )?breath)",
        "fighting for (breath|air)",
        "(not|stopped|isnt|is not|hes not|shes not|theyre not) breathing",
        "gasping( for (air|breath))?",
        "choking",
        "(lips|tongue) .{0,12}(blue|grey|gray|bluish)",
        "(blue|bluish|grey|gray) (lips|tongue)"
      ]
    },
    {
      "id": "en.chest.pain_with_red_flags",
      "level": "emergency",
      "category": "chest_pain",
      "patterns": [
        "chest .{0,15}(pain|pains|painful|hurt|hurts|hurting|ache|aching|tight|tightness|pressure|heavy|heaviness|squeez[a-z]*|crush[a-z]*|burning)",
        "(pain|pains|hurt|hurts|hurting|ache|aching|tight|tightness|pressure|heaviness|squeez[a-z]*|crush[a-z]*) .{0,15}chest"
      ],
      "requiresAlso": [
        [
          "breath|breathe|breathing|breathless[a-z]*",
          "sweat|sweaty|sweating|sweats|clammy",
          "grey|gray|pale",
          "(arm|arms|jaw|neck|back|shoulder) .{0,20}(pain|hurt|hurts|hurting|numb|tingl[a-z]*|heavy|ache|aching)",
          "(pain|hurt|hurts|numb|numbness|tingl[a-z]*|heavy|heaviness) .{0,20}(arm|arms|jaw|neck|back|shoulder)",
          "sick|nause[a-z]*|vomit[a-z]*|faint|dizzy|light ?headed",
          "(spread|spreads|spreading|going|goes) (to|down|into|up)"
        ]
      ]
    },
    {
      "id": "en.chest.crushing",
      "level": "emergency",
      "category": "chest_pain",
      "patterns": [
        "(crush[a-z]*|squeez[a-z]*|heavy weight|elephant) .{0,15}chest",
        "chest .{0,15}(crush[a-z]*|squeez[a-z]*)",
        "(having|is having|hes having|shes having|im having) a heart attack"
      ]
    },
    {
      "id": "en.chest.pain",
      "level": "urgent",
      "category": "chest_pain",
      "patterns": [
        "chest .{0,15}(pain|pains|painful|hurt|hurts|hurting|ache|aching|tight|tightness|pressure|heavy|heaviness|burning)",
        "(pain|pains|hurt|hurts|hurting|ache|aching|tight|tightness|pressure|heaviness) .{0,15}chest"
      ]
    },
    {
