    {
      "id": "en.crisis.suicide_self_harm",
      "level": "crisis",
      "category": "self_harm_or_suicide",
      "patterns": [
        "(kill|killing|hurt|hurting|harm|harming|cut|cutting|end|ending) (myself|meself|my self)",
        "suicid[a-z]*",
        "self harm[a-z]*",
        "(?<!(dont|do not|never|didnt|did not) )(want|wanted|going|gonna|planning|plan) to die",
        "wish (i was|i were|i could be|i was just) dead",
        "(dont|do not|no longer|didnt|did not) (want|wanna) to (be here|be alive|live|go on|wake up|exist)( anymore| any more)?",
        "(end|ending|ended) (it all|my life|my own life|things)",
        "(thinking|thought|think|thinks) (about|of) (ending|end) it",
        "no (point|reason) (in )?(living|to live|going on)",
        "better off (dead|without me)",
        "(take|taking|took) my (own )?life",
        "cant (go on|carry on)( anymore| any more| like this)?"
      ]
    },
    {
      "id": "en.crisis.overdose",
      "level": "emergency",
      "category": "self_harm_or_suicide",
      "patterns": [
        "(took|taken|take|swallowed|had) (an |a )?overdose",
        "(took|taken|swallowed) (all|loads of|lots of|a lot of|too many|the whole (box|packet|pack|bottle) of) (my |his |her |their |the )?(tablets|pills|medication|medicine|paracetamol)"
