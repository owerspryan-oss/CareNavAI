      ],
      "requiresAlso": [
        [
          "blo|blow|briv|breath",
          "sw(ɛ|e)t|sweat",
          "(an|han|arm|jɔ|jo) (de |d(ɔ|o)n )?(at|hat|pen|pain|day|numb)"
