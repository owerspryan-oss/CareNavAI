# Copy to .env.local and fill in. Never commit real values.
OPENAI_API_KEY=
# continue_after_ack (default, v0.3 A2) | locked (fallback)
URGENT_MODE=continue_after_ack
MONTHLY_CAP_GBP=50
DAILY_SESSION_CAP=200
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=300
MAX_TEXT_CHARS=2000
# Confirmed letter/prescription text can be longer than a typed answer
MAX_LETTER_CHARS=6000
MAX_AUDIO_SECONDS=90
MAX_IMAGE_PX=1600
MAX_IMAGE_MB=8
# 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEY=
# true: creating an account needs an invite code (npm run invite:create)
PILOT_INVITE_REQUIRED=false
PUBLIC_BASE_URL=http://localhost:3000
CHILD_AGE_BANDS_STRICT=true
# true shows the "DRAFT, NOT CLINICALLY APPROVED" label (FR-29). Only switch off for the recording.
SHOW_DRAFT_LABEL=true
# true enables the hidden demo menu (Alt+Shift+D) with the fictional inputs in demo/ (FR-26).
DEMO_MODE=false
DATABASE_PATH=data/carenav.sqlite
# Chromium used to render PDFs (ADR-008). Leave blank to use Playwright's browser lookup
# (PLAYWRIGHT_BROWSERS_PATH). This environment: /opt/pw-browsers/chromium-1194/chrome-linux/chrome
CHROMIUM_PATH=
# Largest /api/pdf request body, in KB
MAX_PDF_REQUEST_KB=256
LOG_LEVEL=info
