{
  "name": "carenav-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:urgency": "vitest run --config vitest.urgency.config.ts",
    "test:a11y": "node scripts/a11y.mjs",
    "ui:translate": "node scripts/translate-ui.mjs",
    "ui:review:export": "node scripts/ui-review-export.mjs",
    "ui:review:import": "node scripts/ui-review-import.mjs",
    "invite:create": "node --env-file-if-exists=.env.local scripts/invite.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "next": "^16.4.2",
    "openai": "^7.41.0",
    "pino": "^10.4.0",
    "playwright-core": "1.56.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
